NODE_ENV=development
PORT=5000
API_PREFIX=api
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Host machine → Postgres in Docker
DATABASE_URL=postgresql://fitout:fitout@localhost:5432/fitout?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT=3600

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Optional app version shown in /health
APP_VERSION=0.0.1

# Global throttler (ms / count per IP)
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_TTL=60
THROTTLE_LOGIN_LIMIT=10
THROTTLE_REGISTER_LIMIT=5

# Cloudflare R2 (optional until StorageModule)
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# HTTP Basic Auth for Swagger UI (/docs) + YAML — enforced when NODE_ENV=production
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me
