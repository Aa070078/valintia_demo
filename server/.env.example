NODE_ENV=development
PORT=5000
# SMTP delivery: set credentials privately in your ignored local .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@example.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Valentia <your-gmail-address@example.com>"
API_PREFIX=api
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Host machine → Postgres in Docker
DATABASE_URL=postgresql://fitout:fitout@localhost:5432/fitout?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT=3600

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Use a separate random secret, never the access JWT secret.
EMAIL_VERIFICATION_TOKEN_SECRET=change-me-email-verification-secret-min-32-chars
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=15m

# Must differ from both access and email-verification secrets.
PASSWORD_RESET_TOKEN_SECRET=change-me-password-reset-secret-min-32-chars
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m

# Optional app version shown in /health
APP_VERSION=0.0.1

# Global throttler (ms / count per IP)
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_TTL=60
THROTTLE_LOGIN_LIMIT=10
THROTTLE_REGISTER_LIMIT=5

# Cloudflare R2 (optional until StorageModule)
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# HTTP Basic Auth for Swagger UI (/docs) + YAML — enforced when NODE_ENV=production
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me
# Provisioning credentials expire; only integers 24–72 are supported.
INTERNAL_PROVISIONING_TTL_HOURS=48
