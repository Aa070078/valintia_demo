generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ENGINEER
  PROJECT_MANAGER
  COMPANY_OWNER
  ADMINISTRATOR
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  passwordHash       String
  role               Role
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}