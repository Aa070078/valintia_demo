# Valentia Client Environment Configuration

# Backend API Base URL (defaults to http://localhost:5000/api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Explicit Mock/Demo Fallback Boundary
# Set to "true" to enable prototype showcase mock personas and local storage fallbacks.
# Set to "false" (or leave unset) for strict Real API Mode where backend errors surface directly.
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false
